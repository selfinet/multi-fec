#!/usr/sbin/nft -f
# mfstat — relay 세션별 구간 트래픽 카운터 (테스트망 전용 — 서비스망 적용 금지). 세기만 하고 모두 통과시킨다.
#
# relay 리슨 포트로 들어오고 나가는 것   = client 구간  (키: client IP . client 포트 . relay IP)
# 그 밖의 UDP (세션별 upstream 소켓)     = server 구간  (키: relay 소스 IP . relay 소스 포트)
# 에이전트(mf_agent.py)가 relay 세션 표의 client 주소·relay 소스 주소로 이어 붙인다.
# 10분 동안 오지 않은 항목은 지워진다(relay 세션은 60초 무통신이면 지워지므로 충분하다).
#
# 리슨 포트가 443 이 아니면 아래 LISTEN 을 고친다 (예: { 443, 8443 }).
define LISTEN = { 443 }

table inet mfstat
delete table inet mfstat
table inet mfstat {
	set c2r { type ipv4_addr . inet_service . ipv4_addr; flags dynamic,timeout; timeout 10m; size 65536; counter; }
	set r2c { type ipv4_addr . inet_service . ipv4_addr; flags dynamic,timeout; timeout 10m; size 65536; counter; }
	set r2s { type ipv4_addr . inet_service; flags dynamic,timeout; timeout 10m; size 65536; counter; }
	set s2r { type ipv4_addr . inet_service; flags dynamic,timeout; timeout 10m; size 65536; counter; }

	chain in {
		type filter hook input priority -150; policy accept;
		meta l4proto udp udp dport $LISTEN update @c2r { ip saddr . udp sport . ip daddr }
		meta l4proto udp udp dport != $LISTEN update @s2r { ip daddr . udp dport }
	}
	chain out {
		type filter hook output priority -150; policy accept;
		meta l4proto udp udp sport $LISTEN update @r2c { ip daddr . udp dport . ip saddr }
		meta l4proto udp udp sport != $LISTEN update @r2s { ip saddr . udp sport }
	}
}
