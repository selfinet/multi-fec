# multi-fec 1.4.0 template unit — one file for every role and instance.
#
#   systemctl enable --now multi-fec@client         -> /etc/multi-fec/instances/client.conf
#   systemctl enable --now multi-fec@server-dj08    -> /etc/multi-fec/instances/server-dj08.conf
#   systemctl enable --now multi-fec@relay          -> /etc/multi-fec/instances/relay.conf
#
# instances/ 아래인 이유: 1.3.x 유닛의 EnvironmentFile 이 이미 /etc/multi-fec/<이름>.conf 를 쓰고 있다
# (서비스망 server-dj08.conf · relay.conf · client-djhq.conf). 같은 이름으로 쓰면 롤백용 파일을 덮는다.
# 1.3.x 유닛에서 옮길 때는 mf-migrate.py 를 쓴다.
#
# Per-instance tweaks go in a drop-in (systemctl edit multi-fec@<name>), not here.
# Background: DESIGN-1.4.0.md §9.
[Unit]
Description=multi-fec %i
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target

[Service]
Type=simple
# Not RuntimeDirectory=: systemd removes it when the unit stops, and every
# instance shares /run/multi-fec — stopping one would delete the others' FIFOs.
ExecStartPre=/bin/mkdir -p /run/multi-fec
# Installs the /32 routes that "via"/"gw" need; a no-op without them. Routes are
# deliberately NOT removed on stop (another instance may share them, and a
# restart would leak packets out of the default line in between).
ExecStartPre=/usr/sbin/multi-fec-dist --config /etc/multi-fec/instances/%i.conf --apply-routes
ExecStart=/usr/sbin/multi-fec-dist --config /etc/multi-fec/instances/%i.conf
Restart=on-failure
RestartSec=5
TimeoutStopSec=3

[Install]
WantedBy=multi-user.target
